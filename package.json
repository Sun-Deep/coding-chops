{
  "name": "coding-chops",
  "version": "1.0.0",
  "description": "Open-source visual curriculum for System Design, DSA, and Problem Solving",
  "keywords": [
    "remotion",
    "system-design",
    "data-structures",
    "algorithms",
    "education"
  ],
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@remotion/cli": "4.0.512",
    "@remotion/google-fonts": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.512",
    "@remotion/install-whisper-cpp": "^4.0.512",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "compositions": "remotion compositions src/index.ts",
    "check": "npm run typecheck && npm run lint && npm run validate:curriculum",
    "render:thumbnail": "remotion still src/index.ts SD01-Thumbnail out/sd01-thumbnail.png",
    "render:episode": "remotion render src/index.ts SD01-Master out/sd01-single-server.mp4",
    "narration:silent": "node scripts/silent-narration.mjs system-design/01-single-server"
  },
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sun-Deep/coding-chops.git"
  },
  "bugs": {
    "url": "https://github.com/Sun-Deep/coding-chops/issues"
  },
  "homepage": "https://github.com/Sun-Deep/coding-chops#readme"
}
